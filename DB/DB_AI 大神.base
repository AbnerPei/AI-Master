filters:
  or:
    - file.name.startsWith("AI 大神")
formulas:
  未命名: ""
views:
  - type: cards
    name: AI 大神
    order:
      - file.name
      - file.ctime
      - tags
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 250
    image: note.author_url
    imageAspectRatio: 1
